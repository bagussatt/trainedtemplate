// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PAID
  PENDING
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Customers {
  customerId Int @id @default(autoincrement())
  name String
  email String
  img_url String
  List_Invoices Invoices[] 
}
model Invoices{
  invoicesId Int @id @default(autoincrement())
  custId Int
  amount Int
  status Status @default(PENDING)
  date DateTime @default(now())
  CustomerId Customers @relation(fields: [custId], references: [customerId], onDelete: Cascade, onUpdate: Cascade)
}
model Revenue{
  revenueId Int @id @default(autoincrement())
  month DateTime
  revenue Int
}